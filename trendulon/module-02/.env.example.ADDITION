# --- Module 02 (Discovery) additions — append to your existing .env.example ---

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override — defaults to gemini-2.5-flash in code.
# Verify current free-tier grounding model at https://ai.google.dev/gemini-api/docs/pricing
# before relying on this in production.
GEMINI_MODEL=gemini-2.5-flash

# Should already exist from Module 01/Prisma setup — included for completeness.
DATABASE_URL=
